{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/src/**",
      "/migrations/**",
      "/alembic.ini",
      "/pyproject.toml",
      "/requirements.txt",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["alembic upgrade head"],
    "startCommand": "uvicorn school_ai.api.app:app --app-dir src --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
